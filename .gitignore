# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Virtualenvs
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets (CRITICAL)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
client_secret_*.json
*.token

# Databases & local state
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
imageshrink_v2.db

# Storage artifacts (ephemeral user uploads and compressed outputs)
storage/uploads/*
storage/optimized/*
storage/jobs/*
!storage/uploads/.gitkeep
!storage/optimized/.gitkeep
!storage/jobs/.gitkeep

# Temporary and test artifacts
*.tmp
*.log
.pytest_cache/
.coverage
htmlcov/

# IDE & OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

