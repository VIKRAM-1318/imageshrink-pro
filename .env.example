# ==============================================================================
# ImageShrink Pro V2 Configuration Environment Variables
# ==============================================================================

# Application Environment (development / staging / production)
ENVIRONMENT=production
DEBUG=false
APP_NAME=ImageShrink Pro
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-jwt-signing

# Administrator Access & Security
INITIAL_ADMIN_EMAIL=admin@imageshrink.internal
# Leave blank to auto-generate a secure random one-time password on first startup, or specify here:
INITIAL_ADMIN_PASSWORD=
ADMIN_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-csrf-and-sessions
COOKIE_SECURE=true

# Public API Documentation (Disabled - Set to false in production)
ENABLE_API_DOCS=false

# Database (PostgreSQL for Production, SQLite file for local standalone development)
# Local SQLite default: sqlite:///imageshrink_v2.db
DATABASE_URL=postgresql://imageshrink:secure_pg_password_2026@localhost:5432/imageshrink_prod

# Redis Cache and Celery Task Queue
REDIS_URL=redis://localhost:6379/0

# Object Storage (AWS S3 / Cloudflare R2 / MinIO)
USE_S3_STORAGE=false
S3_ENDPOINT_URL=
S3_BUCKET_NAME=imageshrink-production
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Stripe Payment Gateway
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Gmail API (Transactional Authentication Emails)
# OAuth 2.0 Web Client credentials with scope: https://www.googleapis.com/auth/gmail.send
APP_BASE_URL=http://localhost:8000
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-authorized-offline-gmail-refresh-token
GMAIL_SENDER_EMAIL=notifications@yourdomain.com
GMAIL_SENDER_NAME=ImageShrink Pro Security
# 32-byte urlsafe base64 string for encrypting refresh tokens at rest (generate with python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
GMAIL_TOKEN_ENCRYPTION_KEY=
# Daily limit (500 for standard free Gmail, 2000 for Google Workspace)
GMAIL_DAILY_QUOTA_LIMIT=500

# Google Sign-In (User Authentication)
# Separate OAuth 2.0 credentials with scopes: openid, email, profile
GOOGLE_AUTH_CLIENT_ID=your-google-signin-client-id.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=your-google-signin-client-secret
GOOGLE_AUTH_REDIRECT_URI=http://localhost:8000/api/v2/auth/google/callback

# Limits & Quotas
MAX_FILE_BYTES=36700160 # 35 MB
MAX_BATCH_FILES=500
JOB_TTL_SECONDS=86400 # 24 Hours
